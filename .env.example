# ==============================================================================
# Student Insight AI — Environment Configuration Example
# Copy this file to .env for local overrides (never commit your live .env)
# ==============================================================================

# Backend API URL (used by the Streamlit frontend to reach FastAPI)
# Local: http://127.0.0.1:8000
# Production: https://your-backend-service.onrender.com
API_BASE_URL=http://127.0.0.1:8000

# Backend server host and port (Render dynamically sets $PORT)
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins for FastAPI (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,https://*.streamlit.app

# Python environment settings
PYTHONPATH=.
PYTHONIOENCODING=utf-8
